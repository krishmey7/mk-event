# Environnement local — copier vers .env
DJANGO_SECRET_KEY=dev-only-mk-event-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006

# --- Production (Railway) — ne pas committer les vraies valeurs ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<générer une clé longue et unique>
# DJANGO_ALLOWED_HOSTS=.up.railway.app,votre-domaine-api.com
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL_REQUIRE=true
# CORS_ALLOWED_ORIGINS=https://votre-app.vercel.app
