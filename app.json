{
  "expo": {
    "name": "MK Events",
    "slug": "mk-event",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mkevent",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mkevent.app"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "android": {
      "package": "com.mkevent.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "MK Events",
      "shortName": "MK Events",
      "description": "Créez et envoyez des invitations numériques élégantes.",
      "lang": "fr",
      "themeColor": "#2A1824",
      "backgroundColor": "#2A1824"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MK Events utilise la caméra pour scanner les QR des invités à l’entrée.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
