# Environnement local — copier vers .env (ne pas committer .env)
DJANGO_SECRET_KEY=dev-only-mk-event-change-me-in-production-32chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006

# --- Production (Railway) — Variables du service « web » ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<clé longue unique — voir README / dashboard Railway>
# DJANGO_ALLOWED_HOSTS=.up.railway.app,votre-domaine-api.com
# CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://web-production-3e791.up.railway.app
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL_REQUIRE=true
# CORS_ALLOWED_ORIGINS=https://votre-app.vercel.app
# PUBLIC_BASE_URL=https://web-production-3e791.up.railway.app
# FRONTEND_URL=https://mk-event-five.vercel.app
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=MK Events <onboarding@resend.dev>
# GOOGLE_OAUTH_CLIENT_IDS=xxxxx.apps.googleusercontent.com

# Volume Railway : monter sur /app/media (MEDIA_ROOT) pour persister les uploads.
