# Environnement local — copier vers .env (ne pas committer .env)
DJANGO_SECRET_KEY=dev-only-mk-event-change-me-in-production-32chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006

# --- Production (Render) — Variables du service « mk-event-api » ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<clé longue unique — voir README / dashboard Render>
# DJANGO_ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com
# DATABASE_URL=postgresql://user:pass@host:5432/postgres (Supabase)
# DATABASE_SSL_REQUIRE=true
# CORS_ALLOWED_ORIGINS=https://mk-event-five.vercel.app
# Previews Vercel : regex appliquée en plus des origines ci-dessus.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://mk-event-[a-z0-9-]+\.vercel\.app$
# PUBLIC_BASE_URL=https://mk-event-api.onrender.com
# FRONTEND_URL=https://mk-event-five.vercel.app
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=MK Events <onboarding@resend.dev>
# GOOGLE_OAUTH_CLIENT_IDS=xxxxx.apps.googleusercontent.com

# --- Stockage média (S3-compatible) ---
# Vide en local : les fichiers vont dans backend/media/.
# Render free n'a pas de disque persistant : renseigner un bucket PUBLIC
# (Supabase Storage, AWS S3, Cloudflare R2 ou MinIO).
#
# Exemple Supabase Storage :
# AWS_STORAGE_BUCKET_NAME=mk-event-media
# AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=eu-west-3
# AWS_S3_ADDRESSING_STYLE=path
# AWS_ACCESS_KEY_ID=<storage access key>
# AWS_SECRET_ACCESS_KEY=<storage secret key>
# AWS_S3_CUSTOM_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/mk-event-media
#
# AWS S3 : laisser AWS_S3_ENDPOINT_URL et AWS_S3_CUSTOM_DOMAIN vides.
# Cloudflare R2 : endpoint https://<account>.r2.cloudflarestorage.com,
#                 AWS_S3_REGION_NAME=auto, AWS_S3_CUSTOM_DOMAIN=<domaine public R2>.
# MinIO : endpoint http(s)://host:9000, AWS_S3_ADDRESSING_STYLE=path.
#
# Les URLs doivent rester stables : garder AWS_QUERYSTRING_AUTH=false
# (bucket public). Sinon les liens signés expirent et cassent les invitations.
# AWS_QUERYSTRING_AUTH=false
